<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Follows the phone's light / dark setting. The app draws its own title, so no action bar. -->
    <style name="AppTheme" parent="@android:style/Theme.DeviceDefault.DayNight">
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <!-- Dark status / navigation bar icons on the light theme. -->
        <item name="android:windowLightStatusBar">?android:attr/isLightTheme</item>
        <item name="android:windowLightNavigationBar">?android:attr/isLightTheme</item>
    </style>
</resources>
