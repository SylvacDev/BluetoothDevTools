<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.IO.Ports" Version="10.0.15" />
    <PackageReference Include="System.Management" Version="10.0.15" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="CoreWpfUtils">
      <HintPath>..\SylvacBleLib\CoreWpfUtils.dll</HintPath>
    </Reference>
    <Reference Include="LibUtils">
      <HintPath>..\SylvacBleLib\LibUtils.dll</HintPath>
    </Reference>
    <Reference Include="LogUtils">
      <HintPath>..\SylvacBleLib\LogUtils.dll</HintPath>
    </Reference>
    <Reference Include="Sylvac.Bluetooth.BgApi">
      <HintPath>..\SylvacBleLib\Sylvac.Bluetooth.BgApi.dll</HintPath>
    </Reference>
    <Reference Include="Sylvac.Bluetooth.LayerCentral">
      <HintPath>..\SylvacBleLib\Sylvac.Bluetooth.LayerCentral.dll</HintPath>
    </Reference>
    <Reference Include="Sylvac.Bluetooth.LayerCommons">
      <HintPath>..\SylvacBleLib\Sylvac.Bluetooth.LayerCommons.dll</HintPath>
    </Reference>
    <Reference Include="Sylvac.Bluetooth.LayerConnection">
      <HintPath>..\SylvacBleLib\Sylvac.Bluetooth.LayerConnection.dll</HintPath>
    </Reference>
    <Reference Include="Sylvac.Bluetooth.LayerScan">
      <HintPath>..\SylvacBleLib\Sylvac.Bluetooth.LayerScan.dll</HintPath>
    </Reference>
    <Reference Include="Sylvac.Bluetooth.LayerStack">
      <HintPath>..\SylvacBleLib\Sylvac.Bluetooth.LayerStack.dll</HintPath>
    </Reference>
    <Reference Include="Sylvac.Constants">
      <HintPath>..\SylvacBleLib\Sylvac.Constants.dll</HintPath>
    </Reference>
    <Reference Include="Sylvac.PortDetection">
      <HintPath>..\SylvacBleLib\Sylvac.PortDetection.dll</HintPath>
    </Reference>
    <Reference Include="SylvacBleLib">
      <HintPath>..\SylvacBleLib\SylvacBleLib.dll</HintPath>
    </Reference>
  </ItemGroup>

  <!-- Single-file Release build -->
  <PropertyGroup Condition="'$(Configuration)'=='Release'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <AllowedReferenceRelatedFileExtensions>.none</AllowedReferenceRelatedFileExtensions>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\SylvacBleLib\dllres\win-x64\serialwin.dll" Link="dllres\win-x64\serialwin.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
